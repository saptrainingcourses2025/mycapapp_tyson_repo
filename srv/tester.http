###Testing Deep Insert - pass batch of data together Header+Item
POST http://localhost:4004/odata/v4/CatelogService/PurchaseOrderSet
Content-Type: application/json

{
  "CURRENCY_code": "EUR",
  "GROSS_AMOUNT": 18142.74,
  "NET_AMOUNT": 15246,
  "TAX_AMOUNT": 2896.74,
  "NODE_KEY": "74867AD200E41EDBA5D8B0C98DC21234",
  "PO_ID": "300005555",
  "PARTNER_GUID_NODE_KEY": "74867AD200E41EDBA5D8B06885B08052",
  "LIFECYCLE_STATUS": "N",
  "OVERALL_STATUS": "P",
  "NOTE": "Example for 2 items",
  "Items": [
    {
      "CURRENCY_code": "DKK",
      "GROSS_AMOUNT": 2424.03,
      "NET_AMOUNT": 2037,
      "TAX_AMOUNT": 387.03,
      "NODE_KEY": "74867AD200E41EDBA5D8B0CBD35C6011",
      "PO_ITEM_POS": 10,
      "PRODUCT_GUID_NODE_KEY": "74867AD200E41EDBA5D8B06B26F64052"
    },
    {
      "CURRENCY_code": "DKK",
      "GROSS_AMOUNT": 1783.81,
      "NET_AMOUNT": 1499,
      "TAX_AMOUNT": 284.81,
